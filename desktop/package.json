{
  "name": "supplyop",
  "productName": "SupplyOp",
  "version": "1.0.1",
  "description": "보급기지 작전 PC 버전",
  "author": "Hany36",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.hany36.supplyop",
    "productName": "SupplyOp",
    "files": ["main.js", "offline/**"],
    "win": { "target": "portable" },
    "portable": { "artifactName": "SupplyOp.exe" }
  }
}
